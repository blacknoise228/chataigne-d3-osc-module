{
  "name":"Disguise D3 OSC",
  "type":"OSC",
  "path":"Software",
  
  "version":"0.1.0",
  "description":"Disguise D3 OSC custom module",
  "url":"https://github.com/blacknoise228/chataigne-d3-osc-module",
	"downloadURL":"https://github.com/blacknoise228/chataigne-d3-osc-module/archive/master.zip",

  "hasInput":true,
  "hasOutput":true, 

  "hideDefaultCommands":false,
  
  "defaults":
  {	
    "autoAdd":true,
    "OSC Input":
		{
			"localPort":7402
		},
		"OSC Outputs": {
			"OSC Output": {
				"local": true,
				"remoteHost": "192.168.1.1",
				"remotePort": 7401,
        "listenToFeedback": true
			}
		}
  },

  "scripts": 
  [
    "d3_osc.js"
  ],

  "commands":
  {
    
    "Timeline":
    {
      "menu":"",  
      "callback":"sendCommand",
      "parameters":
      {
        "Timeline":
        {
          "type":"Enum",
          "options":
					{
						"Play":"play",
						"Play to end of section":"playsection",
            "Loop section": "loop",
            "Stop": "stop",
            "Previous section": "previoussection",
            "Next section":"nextsection",
            "Return to start":"returntostart",
            "Previous track":"previoustrack",
            "Next track":"nexttrack"
					}
        }
      }
    },
    "Cue":
    {
      "menu":"",  
      "callback":"sendCueCommand",
      "parameters":
      {
        "Cue number":
        {
          "type":"Integer",
          "min": 0,
          "default": 0
        }
      }
    },
    "Fade":
    {
      "menu":"",  
      "callback":"sendCommand",
      "parameters":
      {
        "Fade":
        {
          "type":"Enum",
          "options":
					{
						"Fade Up":"fadeup",
            "Fade Down":"fadedown"
					}
        }
      }
    }
  }
}